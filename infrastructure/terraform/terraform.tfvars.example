###############################################################################
# terraform.tfvars — agent-memory-graph
#
# Replace <PROJECT_ID_*> tokens with actual GCP project IDs before running
# terraform plan. These project IDs correspond to the three workspaces:
#   dev  → used for development and testing of the service itself
#   intg → integration environment, runs advana workflow before prod gate
#   prod → first production adopter (or shared prod infra)
#
# For each new adopting project, copy this file to a separate location and
# replace the project IDs with that project's dev/intg/prod IDs.
###############################################################################

# ---------------------------------------------------------------------------
# GCP project IDs — Cloud Run lives here
# ---------------------------------------------------------------------------

project_id = {
  dev  = "<PROJECT_ID_DEV>"
  intg = "<PROJECT_ID_INTG>"
  prod = "<PROJECT_ID_PROD>"
}

# ---------------------------------------------------------------------------
# Spanner project — may be the same as project_id or a central data project
# For the initial deployment, Spanner lives in the same project as Cloud Run.
# ---------------------------------------------------------------------------

spanner_project_id = {
  dev  = "<PROJECT_ID_DEV>"
  intg = "<PROJECT_ID_INTG>"
  prod = "<PROJECT_ID_PROD>"
}

# ---------------------------------------------------------------------------
# Spanner instance IDs — provisory names; instances are created by Task 3.
# ---------------------------------------------------------------------------

spanner_instance_id = {
  dev  = "agent-memory-graph-dev"
  intg = "agent-memory-graph-intg"
  prod = "agent-memory-graph-prod"
}

# ---------------------------------------------------------------------------
# Region
# ---------------------------------------------------------------------------
#
# Guidance:
# - us-east1: lower latency to shared US-based control planes and commonly used
#   by platform tooling.
# - southamerica-east1: lower latency for LATAM end users and data locality.
#
# Spanner trade-off:
# - Regional (single region): lower cost and write latency.
# - Multi-region: higher availability/DR at higher cost and write latency.
#
# Start with regional Spanner in the same region as Cloud Run for MVP,
# then evaluate multi-region for strict resiliency requirements.

region = {
  dev  = "us-east1"
  intg = "us-east1"
  prod = "southamerica-east1"
}

# ---------------------------------------------------------------------------
# Tenant identifier — fixed for the entire deployment.
# Must be a non-empty string; used as TenantId in all Spanner tables.
# ---------------------------------------------------------------------------

company_id = "latam-airlines"

# ---------------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------------

auth_mode = "internal"

# ---------------------------------------------------------------------------
# Container image — updated by CI on each build (see Task 5).
# Set to a valid image URI before running terraform apply manually.
# Format: {region}-docker.pkg.dev/{project_id}/agent-memory-graph/api:{tag}
# ---------------------------------------------------------------------------

container_image = "us-docker.pkg.dev/<PROJECT_ID_DEV>/agent-memory-graph/api:latest"

# ---------------------------------------------------------------------------
# CI/CD service accounts — cosmos-cicd-sa must exist in each project.
# ---------------------------------------------------------------------------

cicd_sa_email = {
  dev  = "cosmos-cicd-sa@<PROJECT_ID_DEV>.iam.gserviceaccount.com"
  intg = "cosmos-cicd-sa@<PROJECT_ID_INTG>.iam.gserviceaccount.com"
  prod = "cosmos-cicd-sa@<PROJECT_ID_PROD>.iam.gserviceaccount.com"
}

# ---------------------------------------------------------------------------
# Optional: Google group for agent impersonation of the product SA
# Set to "" to disable.
# ---------------------------------------------------------------------------

agents_group_email = ""

# ---------------------------------------------------------------------------
# Scaling (defaults from variables.tf are usually fine; override if needed)
# ---------------------------------------------------------------------------

cloud_run_min_instances = {
  dev  = 1
  intg = 1
  prod = 2
}

cloud_run_max_instances = {
  dev  = 5
  intg = 10
  prod = 20
}

# Notification channels for alert policies (leave empty to use Cloud Monitoring console only)
# Create channels via: gcloud alpha monitoring channels create
notification_channels = []

# Optional VPC connector names for private egress from Cloud Run
vpc_connector_name = {
  dev  = ""
  intg = ""
  prod = ""
}

# Optional Workload Identity Federation (recommended over GOOGLE_CREDENTIALS)
enable_workload_identity_federation = false
gitlab_oidc_issuer_uri              = "https://gitlab.com"
gitlab_oidc_allowed_audiences       = ["https://sts.googleapis.com"]
gitlab_project_path                 = "<GROUP>/<SUBGROUP>/agent-memory-graph"
workload_identity_pool_id           = "gitlab-ci-pool"
workload_identity_provider_id       = "gitlab-ci-provider"

# Seven-year retention for audit logs
audit_log_retention_days = 2555

# Cloud Scheduler maintenance jobs (EPIC-03)
enable_scheduler_jobs  = true
scheduler_location     = "us-central1"
scheduler_time_zone    = "UTC"
scheduler_decay_schedule = "0 2 * * *"
scheduler_prune_schedule = "0 3 * * 0"
scheduler_decay_rate     = 0.05
scheduler_prune_threshold = 0.30
scheduler_decay_absence_window = "129600s"
scheduler_prune_absence_window = "691200s"

# EPIC-06 SLOs and burn-rate controls
monitoring_service_id         = "agent-memory-graph"
slo_rolling_period_days       = 30
slo_target_availability       = 0.995
slo_target_latency            = 0.95
slo_target_error_rate         = 0.99
slo_latency_threshold_ms      = 500
slo_burn_rate_short_threshold = 14
slo_burn_rate_long_threshold  = 6
slo_burn_rate_short_window    = "300s"
slo_burn_rate_long_window     = "3600s"
